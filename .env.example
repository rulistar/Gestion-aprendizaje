# Copia este archivo a .env y reemplaza los valores. .env NUNCA se sube a Git.
#   cp .env.example .env

# --- API ---
NODE_ENV=development
API_HOST=127.0.0.1
# Puertos distintos a los de Gestor de Proyectos (3000 y 5173) para correr las dos apps a la vez
API_PORT=3001
LOG_LEVEL=info
# Minutos sin actividad tras los que expira una sesión
SESSION_IDLE_MINUTES=60
# Orígenes (separados por comas) que pueden llamar a la API desde el navegador
CORS_ORIGINS=http://localhost:5174
# true solo cuando la API corre detrás del proxy del hosting (lee X-Forwarded-Proto/For)
TRUST_PROXY=false

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=aprendizaje
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=aprendizaje_dev
# 5433 y no 5432: el PostgreSQL de Gestor de Proyectos ya usa el 5432
POSTGRES_PORT=5433

# Cadena de conexión que usa Prisma. Debe coincidir con los valores de arriba.
DATABASE_URL=postgresql://aprendizaje:cambia_esta_contrasena@localhost:5433/aprendizaje_dev

# BD de pruebas (opcional). Si no se define, se usa DATABASE_URL con el sufijo _test (aprendizaje_dev_test).
# Las pruebas la crean y migran solas, y se niegan a correr contra una BD que no termine en _test.
# TEST_DATABASE_URL=postgresql://aprendizaje:cambia_esta_contrasena@localhost:5433/aprendizaje_dev_test
