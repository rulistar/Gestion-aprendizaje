// Modelo de datos base: mismas reglas que el ADR-0002 de Gestor de Proyectos (ver ADR-0001 de este repo).
// Convenciones: UUID v7, tablas/columnas en snake_case, timestamptz, trazabilidad y borrado lógico.
// TEC-01: User, Session, Workspace, Membership. TEC-02: Invitation. HU-01: CatalogItem. HU-02: ElementType. HU-03: Element. El resto se agrega con su historia.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // partialIndexes: índices únicos que ignoran registros en la papelera
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserKind {
  HUMAN
  SERVICE // usuario de servicio de una app externa

  @@map("user_kind")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum CatalogKind {
  PLATFORM
  SPONSOR
  CATEGORY
  LEVEL
  ACTIVITY_TYPE

  @@map("catalog_kind")
}

enum ElementStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  CANCELLED
  DONE

  @@map("element_status")
}

enum MembershipRole {
  ADMIN
  MEMBER
  VIEWER

  @@map("membership_role")
}

/// Persona (o app externa) con cuenta. Nunca se borra físicamente: se desactiva.
model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// Siempre en minúsculas y sin espacios (lo normaliza la capa de servicios)
  email         String     @unique
  name          String
  /// Hash Argon2id. Nulo en usuarios de servicio (no inician sesión con contraseña)
  passwordHash  String?    @map("password_hash")
  kind          UserKind   @default(HUMAN)
  status        UserStatus @default(ACTIVE)
  /// Administra la instalación (lo recibe el primer Admin creado con setup:admin)
  isSystemAdmin Boolean    @default(false) @map("is_system_admin")
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  sessions    Session[]
  memberships Membership[] @relation("MembershipUser")

  // Relaciones inversas de trazabilidad
  usersCreated       User[]       @relation("UserCreatedBy")
  usersUpdated       User[]       @relation("UserUpdatedBy")
  workspacesCreated  Workspace[]  @relation("WorkspaceCreatedBy")
  workspacesUpdated  Workspace[]  @relation("WorkspaceUpdatedBy")
  workspacesDeleted  Workspace[]  @relation("WorkspaceDeletedBy")
  membershipsCreated Membership[] @relation("MembershipCreatedBy")
  membershipsUpdated Membership[] @relation("MembershipUpdatedBy")
  membershipsDeleted Membership[] @relation("MembershipDeletedBy")
  invitationsAccepted Invitation[] @relation("InvitationAcceptedBy")
  invitationsRevoked  Invitation[] @relation("InvitationRevokedBy")
  invitationsCreated  Invitation[] @relation("InvitationCreatedBy")
  invitationsUpdated  Invitation[] @relation("InvitationUpdatedBy")
  catalogItemsCreated CatalogItem[] @relation("CatalogItemCreatedBy")
  catalogItemsUpdated CatalogItem[] @relation("CatalogItemUpdatedBy")
  elementTypesCreated ElementType[] @relation("ElementTypeCreatedBy")
  elementTypesUpdated ElementType[] @relation("ElementTypeUpdatedBy")
  elementsCreated Element[] @relation("ElementCreatedBy")
  elementsUpdated Element[] @relation("ElementUpdatedBy")
  elementsDeleted Element[] @relation("ElementDeletedBy")

  @@map("users")
}

/// Sesión activa. Se guarda el hash SHA-256 del token, nunca el token.
/// Dato técnico: se elimina físicamente al cerrar sesión o expirar.
model Session {
  tokenHash  String   @id @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Espacio de trabajo: frontera de seguridad de toda la información de negocio.
model Workspace {
  id   String @id @default(uuid(7)) @db.Uuid
  name String

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("WorkspaceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("WorkspaceDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  memberships Membership[]
  invitations Invitation[]
  catalogItems CatalogItem[]
  elementTypes ElementType[]
  elements Element[]

  @@map("workspaces")
}

/// Pertenencia de un usuario a un workspace, con su rol (roles por workspace).
model Membership {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        MembershipRole
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User           @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("MembershipUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("MembershipDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  /// Un usuario es miembro una sola vez por workspace, sin contar las membresías en la papelera
  @@unique([workspaceId, userId], map: "memberships_workspace_user_active_key", where: { deletedAt: null })
  @@index([userId])
  @@map("memberships")
}

/// Invitación a un workspace: enlace de un solo uso. Se guarda el hash del token, nunca el token.
model Invitation {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Siempre en minúsculas y sin espacios, como User.email
  email       String
  role        MembershipRole
  tokenHash   String         @unique @map("token_hash")
  /// 48 horas después de crearla, como en Gestor de Proyectos
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)

  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  acceptedBy   User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById  String?   @map("revoked_by_id") @db.Uuid
  revokedBy    User?     @relation("InvitationRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("InvitationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@map("invitations")
}

/// Un valor de un catálogo del espacio. Los cinco catálogos comparten reglas: una sola tabla.
/// No se borra: se archiva (deja de ofrecerse y lo que ya lo usa lo conserva).
model CatalogItem {
  id          String      @id @default(uuid(7)) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        CatalogKind
  name        String
  position    Int         @default(0)
  archivedAt  DateTime?   @map("archived_at") @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("CatalogItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("CatalogItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  elementsAsPlatform Element[] @relation("ElementPlatform")
  elementsAsSponsor  Element[] @relation("ElementSponsor")
  elementsAsCategory Element[] @relation("ElementCategory")
  elementsAsLevel    Element[] @relation("ElementLevel")

  /// Sin duplicados entre los activos; los archivados no ocupan el nombre
  @@unique([workspaceId, kind, name], map: "catalog_items_workspace_kind_name_active_key", where: { archivedAt: null })
  @@index([workspaceId, kind])
  @@map("catalog_items")
}

/// Tipo de elemento (Curso, Lectura…): decide cómo se llama cada campo de la ficha (ADR-0002 §3).
/// Como los catálogos, se archiva en lugar de borrarse.
model ElementType {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// Solo los nombres propios del tipo; lo valida fieldLabelsSchema de packages/shared
  labels      Json      @default("{}") @db.JsonB
  position    Int       @default(0)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("ElementTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("ElementTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  elements Element[]

  /// Sin duplicados entre los activos; los archivados no ocupan el nombre
  @@unique([workspaceId, name], map: "element_types_workspace_name_active_key", where: { archivedAt: null })
  @@index([workspaceId])
  @@map("element_types")
}

/// Lo que se quiere aprender, con su ficha (ADR-0002 §1). Horas totales no se guardan: se calculan.
/// El tipo y los catálogos usan NoAction, no Restrict: se revisa al final de la instrucción, y así
/// un espacio que se borre en cascada no choca con el orden en que se borran sus tablas.
model Element {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  typeId      String    @map("type_id") @db.Uuid
  type        ElementType @relation(fields: [typeId], references: [id], onDelete: NoAction)
  name        String

  platformId String?      @map("platform_id") @db.Uuid
  platform   CatalogItem? @relation("ElementPlatform", fields: [platformId], references: [id], onDelete: NoAction)
  sponsorId  String?      @map("sponsor_id") @db.Uuid
  sponsor    CatalogItem? @relation("ElementSponsor", fields: [sponsorId], references: [id], onDelete: NoAction)
  categoryId String?      @map("category_id") @db.Uuid
  category   CatalogItem? @relation("ElementCategory", fields: [categoryId], references: [id], onDelete: NoAction)
  levelId    String?      @map("level_id") @db.Uuid
  level      CatalogItem? @relation("ElementLevel", fields: [levelId], references: [id], onDelete: NoAction)

  durationWeeks    Decimal? @map("duration_weeks") @db.Decimal(6, 2)
  daysPerWeek      Int      @default(5) @map("days_per_week")
  hoursPerDay      Decimal? @map("hours_per_day") @db.Decimal(4, 2)
  /// Horas capturadas a mano: si hay, mandan sobre las calculadas
  manualTotalHours Decimal? @map("manual_total_hours") @db.Decimal(8, 2)

  estimatedStart DateTime? @map("estimated_start") @db.Date
  estimatedEnd   DateTime? @map("estimated_end") @db.Date
  actualStart    DateTime? @map("actual_start") @db.Date
  actualEnd      DateTime? @map("actual_end") @db.Date

  status ElementStatus @default(NOT_STARTED)
  notes  String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("ElementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("ElementUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("ElementDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([typeId])
  @@map("elements")
}
